# =====================================================
# CINEMA ENVIRONMENT
# =====================================================
# INSTRUCTIONS:
# 1. Copy to .env
# 2. Fill values, then: docker compose up -d
# 3. NEVER commit .env to Git!
#
# Profiles:
#   docker — docker compose up -d (this file, everything containerized)
#   local  — ./mvnw spring-boot:run, Postgres/Redis via `docker compose up
#            -d postgres redis` only
#   prod   — cloud deployment (Render + Neon + Upstash),
#            SPRING_PROFILES_ACTIVE=prod set as an env var on the hosting
#            platform, not from this file — see the "prod only" section below
# =====================================================

# TIMEZONE
# --------
# Set your local timezone (e.g., Europe/Kyiv, Europe/Berlin, America/New_York)
TZ=Europe/Kyiv

# DATABASE CONFIGURATION
# ----------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cinema_db
DB_USER=cinema
DB_PASSWORD=your_db_password_here

DB_HOST_PORT=5433

# REDIS
# -----
REDIS_HOST=redis
REDIS_PORT=6379

# BACKEND
# -------
BACKEND_HOST_PORT=8080
JWT_SECRET=your_jwt_secret_here

# EMAIL (Brevo)
# --------------
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=noreply@bascinema.com

# FRONTEND
# --------
FRONTEND_HOST_PORT=5173
FRONTEND_URL=http://localhost:5173

# LIQPAY
# ------
LIQPAY_PUBLIC_KEY=sandbox_i1234567890abcdef
LIQPAY_PRIVATE_KEY=sandbox_1234567890abcdef
LIQPAY_SANDBOX_MODE=true
PAYMENT_LIQPAY_CALLBACK_URL=https://your-domain.ngrok-free.dev/api/liqpay/callback
PAYMENT_LIQPAY_RESULT_URL=http://localhost:5173/booking/success

# GOOGLE OAUTH
# ------------
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret

# APP
# ---
APP_BASE_URL=http://localhost:8080

# NGROK
# -----
NGROK_AUTH_TOKEN=your_token_here

# =====================================================
# PROD ONLY (Render + Neon + Upstash)
# =====================================================
# Not read from this file on Render — set these directly in the Render
# dashboard's environment variables, alongside the "required everywhere"
# ones above. Listed here for reference.

# SPRING_PROFILES_ACTIVE=prod

# Neon connection details (sslmode=require is hardcoded in application-prod.yml).
# DB_HOST=ep-xxxx.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_NAME=cinema_db
# DB_USER=your_neon_user
# DB_PASSWORD=your_neon_password

# Upstash gives a full rediss:// (TLS) URL.
# REDIS_URL=rediss://default:your_password@your-instance.upstash.io:6379

# Cloudinary — posters go here instead of local disk, since Render's
# filesystem is wiped on every redeploy. Values from the Cloudinary dashboard.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Vercel frontend URL — where the browser is redirected after OAuth login,
# and where booking/payment/verification email links point.
# FRONTEND_URL=https://cinema-bas.vercel.app

# LiqPay server-to-server callback goes to the Render backend; the
# result_url (browser redirect after payment) goes to the Vercel frontend.
# PAYMENT_LIQPAY_CALLBACK_URL=https://cinema-backend.onrender.com/api/liqpay/callback
# PAYMENT_LIQPAY_RESULT_URL=https://cinema-bas.vercel.app/booking/success
# LIQPAY_SANDBOX_MODE=false

# CORS-allowed origin(s), comma-separated. Falls back to FRONTEND_URL if
# unset. Supports wildcard patterns (matched via Spring's
# setAllowedOriginPatterns) — useful because every Vercel preview deploy
# gets its own random subdomain, not just the production URL above. A
# pattern like https://cinema-bas*.vercel.app covers both the production
# domain and every preview deployment.
# CORS_ALLOWED_ORIGINS=https://cinema-bas*.vercel.app

# Header carrying the real client IP for rate limiting. Render sits behind
# Cloudflare, which sets True-Client-IP itself and overwrites any value sent
# by the client, while X-Forwarded-For keeps whatever the client put first.
# RATE_LIMIT_CLIENT_IP_HEADER=True-Client-IP

# PORT is injected by Render itself — don't set it manually.

# =====================================================
# WHERE TO GET VALUES:
# =====================================================
# DB_PASSWORD      - any password
# JWT_SECRET       - run: openssl rand -base64 32
# BREVO_API_KEY    - https://app.brevo.com/settings/keys/api
# CLOUDINARY_*     - https://console.cloudinary.com (Dashboard page, top)
# LIQPAY_*         - https://www.liqpay.ua/en
# GOOGLE_*         - https://console.cloud.google.com/apis/credentials
# NGROK_AUTH_TOKEN - https://dashboard.ngrok.com/get-started/your-authtoken
# =====================================================