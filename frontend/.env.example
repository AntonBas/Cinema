# Copy to .env.local for local development.

# Public backend origin, used to start Google OAuth2 sign-in
# (the browser is redirected to ${VITE_API_URL}/oauth2/authorize/google).
VITE_API_URL=http://localhost:8080

# Where the Vite dev server proxies /api and /uploads requests.
# Only read by `npm run dev`, not included in the production build.
VITE_PROXY_TARGET=http://localhost:8080
